{
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/create",
      "dest": "/api/create.py"
    },
    {
      "src": "/mails",
      "dest": "/api/mails.py"
    },
    {
      "src": "/test",
      "dest": "/api/create.py"
    }
  ]
}
